{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/anthropic", "function": "anthropicProxy",   "region": "us-central1" },
      { "source": "/api/gemini",    "function": "geminiProxy",      "region": "us-central1" },
      { "source": "/api/bootstrap", "function": "bootstrapProfile", "region": "us-central1" },
      { "source": "/api/weapon",    "function": "generateWeapon",   "region": "us-central1" },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "*.local"],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run lint || true"]
    }
  ],
  "emulators": {
    "auth":      { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "hosting":   { "port": 5000 },
    "ui":        { "enabled": true }
  }
}
