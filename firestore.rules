rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // User profile + per-user data
    match /users/{uid} {
      allow read: if request.auth.uid == uid;
      // Profile is mostly server-managed (plan, credits). Clients may only
      // update fields they're allowed to change — basic profile fields.
      allow create: if request.auth.uid == uid;
      allow update: if request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['name', 'email', 'avatarUrl', 'updatedAt', 'acceptedTermsAt']);
      allow delete: if false;

      match /sessions/{sid} {
        allow read, write: if request.auth.uid == uid;
      }
      match /scenes/{cid} {
        allow read, write: if request.auth.uid == uid;
      }
      match /sounds/{sid} {
        allow read, write: if request.auth.uid == uid;
      }
      match /models/{mid} {
        allow read, write: if request.auth.uid == uid;
      }
      // API keys for external integrations (Roblox plugin, etc.).
      // Clients can list/read their own; only Cloud Functions write/delete.
      match /apiKeys/{keyId} {
        allow read: if request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Global key → uid lookup. Backend-only; never readable by clients.
    match /apiKeys/{key} {
      allow read, write: if false;
    }

    // Shared community feed
    match /community/{post} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.authorUid;
      allow update, delete: if request.auth != null
                            && request.auth.uid == resource.data.authorUid;
    }

    // Shareable links — anyone can read (so non-signed-in recipients can
    // still see what's about to be shared with them), only the owner can
    // create/update/delete.
    match /shares/{shareId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.ownerUid;
      allow update, delete: if request.auth != null
                            && request.auth.uid == resource.data.ownerUid;
    }

    // Stripe extension: customers + their nested checkout/subscription docs.
    // The "firestore-stripe-payments" extension manages writes via webhook;
    // clients only read their own and create checkout sessions.
    match /customers/{uid} {
      allow read: if request.auth.uid == uid;

      match /checkout_sessions/{id} {
        allow read, write: if request.auth.uid == uid;
      }
      match /subscriptions/{id} {
        allow read: if request.auth.uid == uid;
      }
      match /payments/{id} {
        allow read: if request.auth.uid == uid;
      }
    }

    // Public price catalog (managed by the Stripe extension)
    match /products/{id} {
      allow read: if true;
      match /prices/{priceId} {
        allow read: if true;
      }
    }
  }
}
