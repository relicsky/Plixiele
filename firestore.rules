rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // User profile + per-user data
    match /users/{uid} {
      allow read: if request.auth.uid == uid;
      // Profile is mostly server-managed (plan, credits). Clients may only
      // update fields they're allowed to change — basic profile fields.
      allow create: if request.auth.uid == uid;
      allow update: if request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['name', 'email', 'updatedAt', 'acceptedTermsAt']);
      allow delete: if false;

      match /sessions/{sid} {
        allow read, write: if request.auth.uid == uid;
      }
      match /scenes/{cid} {
        allow read, write: if request.auth.uid == uid;
      }
      match /sounds/{sid} {
        allow read, write: if request.auth.uid == uid;
      }
      match /models/{mid} {
        allow read, write: if request.auth.uid == uid;
      }
    }

    // Shared community feed
    match /community/{post} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.authorUid;
      allow update, delete: if request.auth != null
                            && request.auth.uid == resource.data.authorUid;
    }

    // Stripe extension: customers + their nested checkout/subscription docs.
    // The "firestore-stripe-payments" extension manages writes via webhook;
    // clients only read their own and create checkout sessions.
    match /customers/{uid} {
      allow read: if request.auth.uid == uid;

      match /checkout_sessions/{id} {
        allow read, write: if request.auth.uid == uid;
      }
      match /subscriptions/{id} {
        allow read: if request.auth.uid == uid;
      }
      match /payments/{id} {
        allow read: if request.auth.uid == uid;
      }
    }

    // Public price catalog (managed by the Stripe extension)
    match /products/{id} {
      allow read: if true;
      match /prices/{priceId} {
        allow read: if true;
      }
    }
  }
}
